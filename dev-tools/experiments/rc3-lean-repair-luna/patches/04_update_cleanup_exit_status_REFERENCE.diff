@@ -1254,7 +1254,9 @@
 }
 
 cleanup_tmp() {
-	_update_cleanup_rc=$?
+	# Caller passes the real prior exit code; EXIT-trap return alone does not
+	# change shell exit status under Dash or BusyBox ash.
+	_update_cleanup_rc=${1:-$?}
 	_update_cleanup_failed=0
 	_update_pool_cleanup_ready="1"
 	# A signal-path abort failure means rollback was intentionally skipped.
@@ -1332,7 +1334,9 @@
 	exit "$_update_signal_status"
 }
 
-trap cleanup_tmp EXIT
+# Propagate cleanup failure: plain `trap cleanup_tmp EXIT` can exit 0
+# even when cleanup_tmp returns nonzero on Dash/BusyBox ash.
+trap '_update_prior_rc=$?; trap - EXIT; cleanup_tmp "$_update_prior_rc" || exit 1; exit "$_update_prior_rc"' EXIT
 trap 'handle_update_signal 130' INT
 trap 'handle_update_signal 143' TERM
 
