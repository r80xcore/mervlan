+# Source-free subset of Update's runtime idle inventory, for fixtures.
+# It omits Update's authoritative DHCP-hold classifier and cannot prove
+# complete quiescence on a router, even with otherwise cooperative writers.
+# Any existing lock, DHCP/boot shield marker, or Update state blocks.
+# Unlike Update's classifier, a proven-dead owner also blocks: Repair does
+# not quarantine foreign locks or borrow Update's recovery authority.
+runtime_quiet() {
+  owner_ok || return 1
+  safe_chain "$MERV_REPAIR_LEGACY_LOCK_ROOT" || return 1
+  safe_chain "$MERV_REPAIR_STATE_ROOT" || return 1
+  safe_chain "$MERV_REPAIR_LEGACY_LOCK_ROOT/observation" || return 1
+  if [ -d "$MERV_REPAIR_LEGACY_LOCK_ROOT/observation" ]; then
+    [ -r "$MERV_REPAIR_LEGACY_LOCK_ROOT/observation" ] &&
+      [ -x "$MERV_REPAIR_LEGACY_LOCK_ROOT/observation" ] || return 1
+  fi
+  [ -d "$MERV_REPAIR_LEGACY_LOCK_ROOT" ] &&
+    [ -d "$MERV_REPAIR_STATE_ROOT" ] &&
+    [ -r "$MERV_REPAIR_STATE_ROOT" ] &&
+    [ -x "$MERV_REPAIR_STATE_ROOT" ] || return 1
+  for suffix in mervlan_manager.lock vlan_event.lock execute_nodes.lock \
+    client_collect.lock sync_nodes.lock mac_client_meta.lock \
+    mac_snapshot.lock mervlan_action.lock observation/worker.lock \
+    merv_boot_shield.active merv_boot_shield.ready \
+    merv_boot_shield.handoff merv_boot_shield.transient.lock \
+    merv_dhcp_hold.active; do
+    # ls -ld observes dangling symlinks and non-directory obstructions.
+    if ls -ld "$MERV_REPAIR_LEGACY_LOCK_ROOT/$suffix" >/dev/null 2>&1; then
+      return 1
+    fi
+  done
+  for suffix in update.journal update.quiesce; do
+    if ls -ld "$MERV_REPAIR_STATE_ROOT/$suffix" >/dev/null 2>&1; then
+      return 1
+    fi
+  done
+  owner_ok
+}
+wait_runtime_idle() {
+  elapsed=0
+  while ! runtime_quiet; do
+    owner_ok || return 1
+    [ "$elapsed" -lt 6 ] || { status REFUSED 'runtime idle not established'; return 1; }
+    sleep 1
+    elapsed=$((elapsed+1))
+  done
+  status QUIESCENCE "fixture-only partial idle inventory wait=${elapsed}s"
+}
 # A proof of cooperating writer exclusion currently exists ONLY in the local
 # fixture harness. It is impossible for this standalone tool to certify the
 # installed service-event-handler/Heal without their own companion changes.
@@ -575,6 +623,7 @@
   # Gate acquisition precedes all protected-state and destination observations.
   scan_processes || stop 'initial legacy mutator exclusion failed'
   acquire || stop 'maintenance admission refused'
+  wait_runtime_idle || stop 'runtime quiescence not established'
   scan_processes || stop 'post-acquisition legacy mutator exclusion failed'
   protected_files && backup_files || stop 'backup/protected-state capture failed'
   preflight || stop 'resource preflight before publication failed'
