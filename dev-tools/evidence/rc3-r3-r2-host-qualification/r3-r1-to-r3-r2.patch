     if exists "$_sp_target"; then
@@ -1208,7 +1211,10 @@
     SELECTED_BYTES=$((SELECTED_BYTES + _sp_size))
     SELECTED="$SELECTED$_sp_rel|"
     REPLACEMENTS=$((REPLACEMENTS + 1))
